{
  "name": "git-filter",
  "version": "2.5.0",
  "packageManager": "pnpm@9.15.0",
  "description": "Create a filtered copy of a git repo with full commit history preserved",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "prettier": "prettier --write src/ vitest.config.ts",
    "lint:knip": "knip",
    "lint:jscpd": "jscpd src --min-lines 10 --min-tokens 50 --ignore '**/*.test.*' --exit-code 1 --no-colors --no-tips --reporters ai",
    "lint:oxlint": "oxlint --format=agent",
    "lint:slop-scan": "slop-scan scan . --lint | tee /dev/stderr | grep -q '^0 findings$'",
    "lint": "pnpm run \"/^lint:.*/\""
  },
  "repository": "https://github.com/kubk/git-filter",
  "author": "kubk",
  "license": "MIT",
  "private": false,
  "bin": {
    "git-filter": "./dist/index.js"
  },
  "dependencies": {
    "commander": "^8.3.0",
    "ignore": "^7.0.10",
    "write-file-atomic": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/write-file-atomic": "3",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.8.1",
    "slop-scan": "^0.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  }
}
