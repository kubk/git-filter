{
  "name": "git-filter",
  "version": "2.6.0",
  "packageManager": "pnpm@9.15.0",
  "description": "Create a filtered copy of a git repo with full commit history preserved",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "prettier": "prettier --write src/ vitest.config.ts",
    "lint:oxlint": "oxlint --format=agent",
    "lint:slop-police": "slop-police",
    "lint": "pnpm run \"/^lint:.*/\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubk/git-filter.git"
  },
  "author": "kubk",
  "license": "MIT",
  "private": false,
  "bin": {
    "git-filter": "dist/index.js"
  },
  "dependencies": {
    "commander": "^8.3.0",
    "ignore": "^7.0.10",
    "write-file-atomic": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/write-file-atomic": "3",
    "oxlint": "^1.85.0",
    "prettier": "^3.8.1",
    "slop-police": "^0.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  }
}
